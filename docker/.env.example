# Non-secret deployment identity. Do not put tokens in this file.
DEPLOYMENT_NAME=node
SOURCE_REVISION=unknown
BUILD_DATE=unknown
CODEWISE_IMAGE=ghcr.io/andreasmolnardev/codewise:latest
# Point this at a local Compose secret file used only for first enrollment.
TAILSCALE_AUTHKEY_FILE=./secrets/tailscale-authkey
# Optional Subpolar managed execution. Leave unset to keep it disabled.
# SUBPOLAR_MANAGER_URL=http://subpolar-manager:8787
# SUBPOLAR_MANAGER_TOKEN=
# Set ownerId to the configured ACP provider instance ID, for example subpolar_team_a.
# Configure SUBPOLAR_MANAGER_INSTANCE_TOKEN in that provider instance's environment, not Compose.
# T3 binds SUBPOLAR_OWNER_ID and SUBPOLAR_PROVIDER_INSTANCE_ID for that instance.
# SUBPOLAR_MANAGER_INSTANCE_TOKENS={"<instance-token>":{"ownerId":"subpolar_team_a","storageRoot":"/workspaces","allowedOperations":["identity","ensure","start","stdio","execute"]}}
# SUBPOLAR_STORAGE_ROOT=/workspaces
# SUBPOLAR_DOCKER_HOST_STORAGE_ROOT=
# SUBPOLAR_DOCKER_GID=999
# The managed worker image bundles the ACP/Pi runtime. Worker egress remains
# disabled until a filtered model gateway and T3-owned credential path exist.
# SUBPOLAR_ACP_EXECUTION=managed
# SUBPOLAR_ACP_WORKER_COMMAND=["/usr/local/bin/subpolar-acp-worker"]
